# ==================================================
# Backend API (public browser configuration)
# ==================================================
# Local development: http://localhost:5000/api/v1
# Production: set this in Vercel to the deployed API's /api/v1 URL.
#
# NEXT_PUBLIC_* values are visible to browser users. Never place database,
# JWT, SMTP, or payment-provider secrets in this frontend environment file.
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
